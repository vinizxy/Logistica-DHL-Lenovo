# Copie para .env.local e preencha com os valores do projeto Supabase
# (Project Settings > API). A chave publishable/anon e publica por natureza.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Só para supabase/scripts/create_test_users.mjs (admin). Nunca vai para o frontend nem para o git.
# SUPABASE_SERVICE_ROLE_KEY=

# Senhas das contas de teste, usadas pelos testes que batem na API e pelo script acima.
# TEST_LENOVO_PASSWORD=
# TEST_DHL_PASSWORD=
# TEST_ADMIN_PASSWORD=
